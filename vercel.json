{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "market.html",
      "use": "@vercel/static"
    },
    {
      "src": "concept.html",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "continue": true
    },
    {
      "src": "/api/feedback",
      "dest": "/api/feedback.js"
    },
    {
      "src": "/api/market-feedback",
      "dest": "/api/market-feedback.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/market/?",
      "dest": "/market.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
